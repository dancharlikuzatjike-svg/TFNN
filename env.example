# Copy this file to .env and fill in real values before running

PORT=4000

# Postgres connection
DATABASE_URL=postgres://tfnn_user:tfnn_pass@localhost:5432/tfnn

# JWT signing secrets - use long random strings in production
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string

# Access token lifetime (short) and refresh token lifetime (long)
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
